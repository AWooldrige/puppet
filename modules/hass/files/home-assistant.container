[Unit]
Description=Home Assistant container
# The pis have no clock battery
After=network.target time-sync.target
Wants=time-sync.target

[Container]
ContainerName=homeassistant
Image=ghcr.io/home-assistant/home-assistant:stable
Label=io.containers.autoupdate=registry

Volume=/var/lib/homeassistant:/config
Volume=/etc/localtime:/etc/localtime:ro

Environment=TZ=Europe/London
Environment=DISABLE_JEMALLOC=true

PublishPort=8123:8123
Network=host

#Privileged=true
#AddDevice=/dev/zigbee:/dev/ttyUSB0

# Pass through the Sonoff device
AddDevice=/dev/zigbee:/dev/ttyUSB0

# Pass dbus through for bluetooth
Volume=/run/dbus:/run/dbus:ro

# Podman confines containers with its generated containers-default profile,
# which on 26.04 includes D-Bus and denies the opening Hello call, so the
# bluetooth integration cannot reach the bus
PodmanArgs=--security-opt apparmor=unconfined

# No AddCapability=NET_ADMIN / NET_RAW, which Home Assistant's container
# documentation asks for. Bluetooth runs in its degraded mode beacuse of this,
# which is ok

[Service]
Restart=unless-stopped


[Install]
WantedBy=default.target
