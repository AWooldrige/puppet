#########################################################################
##   This file is controlled by Puppet - changes will be overwritten   ##
#########################################################################

[Unit]
Description=Kitchen board kiosk browser
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

ExecCondition=/usr/bin/grep -qxF "enabled_kiosk = true" /etc/toggles.toml

# Wait for the board to actually answer before launching
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 60 --retry-all-errors --retry-delay 2 --output /dev/null http://127.0.0.1:5273/

Environment=MOZ_ENABLE_WAYLAND=1
# Explicit profile, so this never picks up or fights over whatever profile an
# interactive Firefox created.
ExecStart=/snap/bin/firefox --kiosk --profile /home/kitchen/snap/firefox/common/kiosk-profile http://127.0.0.1:5273

Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
