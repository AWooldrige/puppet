#!/usr/bin/env python3
import json
import pathlib
import sys

prompt_file, config_file = map(pathlib.Path, sys.argv[1:3])
prompt = prompt_file.read_text().strip()
config = json.loads(config_file.read_text()) if config_file.exists() else {}

if config.get('advanced', {}).get('whispercpp_initial_prompt') == prompt:
    sys.exit(0)
if '--check' in sys.argv:
    sys.exit(1)

config.setdefault('advanced', {})['whispercpp_initial_prompt'] = prompt
config_file.parent.mkdir(parents=True, exist_ok=True)
part = config_file.with_name(config_file.name + '.part')
part.write_text(json.dumps(config, indent=2) + '\n')
part.replace(config_file)
