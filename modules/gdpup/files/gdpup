#!/bin/bash
FORCE="no"
[ "$1" == "-f" ] && FORCE="yes"

set -Eeuo pipefail
source "${WPU_SHELL:-/usr/share/wpu/wpu_shell}"
trap escalate_if_anything_fails ERR


# Config
GDIR="${GDPUP_DIR:-/etc/gdpup}"
DISABLED_MARKER="${GDPUP_DISABLED_MARKER:-/var/lib/gdpup-disabled-since}"

# Runtime flags
GIT_REMOTE_CHANGES="no"

# -----------
#
#
# The toggle is a kill switch, so -f means "apply even though the remote has not
# moved" rather than "ignore the toggle".
if is_toggle_off "enabled_gdpup"; then
    [ -f "$DISABLED_MARKER" ] || touch "$DISABLED_MARKER"
    DISABLED_DAYS=$(( ($(date +%s) - $(stat -c %Y "$DISABLED_MARKER")) / 86400 ))
    log "gdpup disabled via /etc/toggles.toml, for ${DISABLED_DAYS} days"

    # Only the nightly forced run warns, so a forgotten host nags once a day rather
    # than every 20 minutes. escalate is Pi-only, so a workstation only logs.
    if [ "$FORCE" == "yes" ] && [ "$DISABLED_DAYS" -gt 5 ] \
            && command -v escalate > /dev/null; then
        escalate "gdpup has been disabled in /etc/toggles.toml for ${DISABLED_DAYS} days, so no Puppet changes are being applied"
    fi
    exit 0
fi

rm -f "$DISABLED_MARKER"

if [ ! -f "$GDIR/manifests/nodes.pp" ]; then
    log "Cloning repo to ${GDIR}."
    rm -rf "$GDIR"
    git clone --depth=1 https://github.com/AWooldrige/puppet.git "$GDIR"
    GIT_REMOTE_CHANGES="yes"
fi

cd "$GDIR"

if [ "$(git diff-index --exit-code --quiet HEAD)" ]; then
    log "Local git changes to ${GDIR}, Aborting."
    exit 1
fi

if [ "$GIT_REMOTE_CHANGES" == "no" ]; then
    log "Checking git remote for repo changes"
    OLD_HEAD=$(cat "$GDIR/.git/refs/heads/master")
    git pull
    NEW_HEAD=$(cat "$GDIR/.git/refs/heads/master")
    if [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
        log " -> Updated to $NEW_HEAD"
        GIT_REMOTE_CHANGES="yes"
    else
        log " -> No updates available"
    fi
fi

if [ "$FORCE" == "no" ] && [ "$GIT_REMOTE_CHANGES" == "no" ]; then
    log "No changes, not running puppet apply."
    exit 0
fi

log "Running puppet apply"
puppet apply -v --strict_variables "--modulepath=/etc/puppet/code/modules/:/etc/securepuppet/modules/:${GDIR}/modules" "${GDIR}/manifests"
